{
    "name": "SpessaSynth",
    "version": "4.4.7",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "npm run check && npm run build:fast",
        "build:binary": "node src/build/build_binary.ts",
        "build:fast": "node src/build/build.ts",
        "check": "npm run lint && node node_modules/typescript7/bin/tsc -b",
        "clean": "node -e \"const fs=require('fs/promises'); Promise.all([fs.rm('dist',{recursive:true,force:true}), fs.rm('local-dev',{recursive:true,force:true}), fs.rm('server',{recursive:true,force:true})])\"",
        "deps:local": "node src/build/deps_local.ts",
        "deps:npm": "node src/build/deps_npm.ts",
        "format": "prettier . --write --list-different",
        "format:check": "prettier --check .",
        "lint": "eslint",
        "prepare": "husky",
        "start": "node src/build/start.ts"
    },
    "devDependencies": {
        "@chialab/esbuild-plugin-meta-url": "^0.19.2",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "skia-canvas": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "typescript7": "npm:typescript@^7.0.2"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "*.{html,json,md,yml,yaml,css}": "prettier --write"
    },
    "dependencies": {
        "fflate": "^0.8.3",
        "jszip": "^3.10.2",
        "mediabunny": "^1.64.0",
        "spessasynth_core": "latest",
        "spessasynth_lib": "latest",
        "wasm-media-encoders": "^0.7.0"
    },
    "engines": {
        "node": ">=24"
    },
    "overrides": {
        "minimatch": "^11.0.4"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
