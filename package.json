{
    "name": "SpessaSynth",
    "version": "4.3.14",
    "type": "module",
    "private": true,
    "scripts": {
        "test:types": "eslint && tsc -b",
        "start": "node src/build/start.ts",
        "build": "npm run test:types && npm run build:fast",
        "build:fast": "node src/build/build.ts",
        "format": "prettier . --write",
        "dev": "node src/build/dev.ts",
        "release": "node src/build/release.ts",
        "clean": "node -e \"const fs=require('fs/promises'); Promise.all([fs.rm('dist',{recursive:true,force:true}), fs.rm('local-dev',{recursive:true,force:true}), fs.rm('server',{recursive:true,force:true})])\""
    },
    "devDependencies": {
        "@chialab/esbuild-plugin-meta-url": "^0.19.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.6.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.6.0",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "*.{html,json,md,yml,yaml,css}": "prettier --write"
    },
    "dependencies": {
        "jszip": "^3.10.1",
        "spessasynth_core": "file:../spessasynth_core",
        "spessasynth_lib": "file:../spessasynth_lib"
    }
}
