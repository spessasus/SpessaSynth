{
    "name": "SpessaSynth",
    "version": "4.4.1",
    "type": "module",
    "private": true,
    "scripts": {
        "test:types": "eslint && tsc -b",
        "start": "node src/build/start.ts",
        "build": "npm run test:types && npm run build:fast",
        "build:fast": "node src/build/build.ts",
        "format": "prettier . --write --list-different",
        "dev": "node src/build/dev.ts",
        "release": "node src/build/release.ts",
        "video": "tsx src/cli_video/index.ts",
        "clean": "node -e \"const fs=require('fs/promises'); Promise.all([fs.rm('dist',{recursive:true,force:true}), fs.rm('local-dev',{recursive:true,force:true}), fs.rm('server',{recursive:true,force:true})])\""
    },
    "devDependencies": {
        "@chialab/esbuild-plugin-meta-url": "^0.19.1",
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-unicorn": "^64.0.0",
        "globals": "^17.13.0",
        "prettier": "^3.8.3",
        "skia-canvas": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "prettier --write",
            "eslint --cache --fix"
        ],
        "*.{html,json,md,yml,yaml,css}": "prettier --write"
    },
    "dependencies": {
        "fflate": "^0.8.3",
        "jszip": "^3.10.2",
        "mediabunny": "^1.61.3",
        "spessasynth_core": "latest",
        "spessasynth_lib": "latest",
        "wasm-media-encoders": "^0.7.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
